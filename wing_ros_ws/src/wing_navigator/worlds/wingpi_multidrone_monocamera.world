        <pose>0 -0.07 -0.02 0 -0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00431371</ixx>
            <ixy>0</ixy>
            <iyy>0.00387382</iyy>
            <ixz>0</ixz>
            <iyz>0</iyz>
            <izz>0.00809845</izz>
          </inertia>
          <pose>0 0 0 0 -0 0</pose>
