            <izz>1</izz>
          </inertia>
          <mass>1</mass>
        </inertial>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <joint name='zephyr_monocamera::front_camera_optical_joint' type='fixed'>
        <parent>__default__</parent>
        <child>__default__</child>
        <origin xyz='0.0 0.0 0.0' rpy='${-pi/2} 0.0 ${-pi/2}'/>
      </joint>
      <link name='cam_link'>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
          <pose>0 0 0 0 -0 0</pose>
        </inertial>
