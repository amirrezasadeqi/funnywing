      <frame name='zephyr_monocamera::__model__' attached_to='zephyr_monocamera::front_camera_link'>
        <pose relative_to='__model__'>0 -0.34 0.25 0 0 -1.5707</pose>
      </frame>
      <link name='zephyr_monocamera::front_camera_link'>
        <pose relative_to='zephyr_monocamera::__model__'>0 0 0 0 -0 0</pose>
        <visual name='front_camera_link_visual'>
          <geometry>
            <box>
              <size>0.014 0.014 0.016</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Red</name>
              <uri>__default__</uri>
            </script>
          </material>
        </visual>
        <collision name='front_camera_link_collision'>
          <geometry>
            <box>
              <size>0.014 0.014 0.016</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <sensor name='front_camera' type='camera'>
          <camera>
            <!-- <horizontal_fov>2.7052</horizontal_fov> -->
            <horizontal_fov>0.5</horizontal_fov>
            <image>
              <format>R8G8B8</format>
              <width>1920</width>
              <height>1080</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>1</visualize>
          <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
            <cameraName>front_camera_ns</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>zephyr_monocamera::front_camera_optical_link</frameName>
          </plugin>
          <!-- This plugin must be installed by PX4-Autopilot repository -->
          <plugin name="GstCameraPlugin" filename="libgazebo_gst_camera_plugin.so">
            <robotNamespace></robotNamespace>
            <!-- udpHost is the IP of the system we run GCS on it. -->
            <!-- <udpHost>127.0.0.1</udpHost> -->
            <udpHost>192.168.1.3</udpHost>
            <udpPort>8500</udpPort>
          </plugin>
        </sensor>
        <self_collide>0</self_collide>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
          <mass>1</mass>
        </inertial>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
        <mass>0.0036</mass>
      </link>
      <link name='zephyr_monocamera::front_camera_optical_link'>
        <pose relative_to='zephyr_monocamera::__model__'>0 0 0 0 -0 0</pose>
        <self_collide>0</self_collide>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <inertia>
