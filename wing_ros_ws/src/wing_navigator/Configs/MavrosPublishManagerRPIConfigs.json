[
  {
    "name": "MavlinkPublisher",
    "enable": true,
    "topicName": "/GCS/from",
    "msgPack": "mavros_msgs",
    "msgType": "Mavlink",
    "rate": 1000,
    "queueSize": 100,
    "onMessage": "ALL_MESSAGE_TYPES"
  },
  {
    "name": "ManualControlPublisher",
    "enable": true,
    "topicName": "/funnywing/manual_control",
    "msgPack": "mavros_msgs",
    "msgType": "ManualControl",
    "rate": 50,
    "queueSize": 1,
    "onMessage": "MANUAL_CONTROL"  
  },
  {
    "name": "targetGlobalPositionPublisher",
    "enable": true,
    "topicName": "/funnywing/targetGlobalPosition",
    "msgPack": "sensor_msgs",
    "msgType": "NavSatFix",
    "rate": 5,
    "queueSize": 5,
    "onMessage": "POSITION_TARGET_GLOBAL_INT",
    "messageFields": [
      "lat_int",
      "lon_int",
      "alt"
    ]
  },
  {
    "name": "targetVelocityPublisher",
    "enable": true,
    "topicName": "/funnywing/targetVelocity",
    "msgPack": "geometry_msgs",
    "msgType": "TwistStamped",
    "rate": 5,
    "queueSize": 5,
    "onMessage": "POSITION_TARGET_GLOBAL_INT",
    "messageFields": [
      "vx",
      "vy",
      "vz"
    ]
  },
  {
    "name": "rcChannelsOverridePublisher",
    "enable": true,
    "topicName": "/mavros/rc/override",
    "msgPack": "mavros_msgs",
    "msgType": "OverrideRCIn",
    "rate": 20,
    "queueSize": 5,
    "onMessage": "RC_CHANNELS_OVERRIDE"
  }
]
